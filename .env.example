# Optional deployment overrides. Never store a private key or secret here.
# GenLayer CLI 0.39.2 does not auto-load this file; export these values into the
# current shell before running `pnpm run deploy`.

# Required fail-closed network guard: studionet first, then bradbury.
QUESTIONZERO_DEPLOY_STAGE=studionet

# Immutable policy revision passed to the constructor.
QUESTIONZERO_POLICY_VERSION=1

# Receipt polling only. Defaults allow up to two hours for consensus and finality.
QUESTIONZERO_RECEIPT_RETRIES=1440
QUESTIONZERO_RECEIPT_INTERVAL_MS=5000
